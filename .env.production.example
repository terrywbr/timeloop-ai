# 部署到 Cloudflare 時使用（複製為 .env.production.local）
# NEXT_PUBLIC_* 會在 build 時打包進前端

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://app.timeloopai.net
NEXT_PUBLIC_APP_SITE_URL=https://app.timeloopai.net
NEXT_PUBLIC_CN_SITE_URL=https://cn.timeloopai.net
NEXT_PUBLIC_STREAM_PROXY_URL=https://stream.timeloopai.net

# Server-side billing (set via GitHub Secrets → wrangler deploy, or `wrangler secret put`)
# LEMON_SQUEEZY_API_KEY
# LEMON_SQUEEZY_STORE_ID
# LEMON_SQUEEZY_VIP_VARIANT_ID
# LEMON_SQUEEZY_CREDIT_PACK_VARIANT_ID
# LEMON_SQUEEZY_CREDIT_PACK_CREDITS=100
# LEMON_SQUEEZY_WEBHOOK_SECRET
# Webhook URL: https://app.timeloopai.net/api/webhooks/lemonsqueezy
